{
    "name": "Video Transcription Tool",
    "image": "mcr.microsoft.com/devcontainers/python:3.12",
    "customizations": {
      "vscode": {
        "settings": {
          "python.defaultInterpreterPath": "/usr/local/bin/python",
          "python.linting.enabled": true,
          "python.linting.pylintEnabled": true
        },
        "extensions": [
          "ms-python.python",
          "ms-python.vscode-pylance",
          "njpwerner.autodocstring"
        ]
      }
    },
    "mounts": [{
      "source": "${localEnv:HOME}",
      "target": "${containerWorkspaceFolder}/con-home",
      "type": "bind"
    }],
    "onCreateCommand": {
      "update": "sudo apt update && sudo apt upgrade -y",
      "ffmpeg": "sudo apt install ffmpeg -y"
    },
    "postCreateCommand": {
      "ownership": "chown -R ${remoteUser}:${remoteUser} ${containerWorkspaceFolder}",
      "rrequirement": "pip install -r requirements.txt"
  }
